config-file = keybindings
config-file = font-jetbrains-mono
config-file = ?config.local.ghostty

cursor-style = block
custom-shader = ~/.config/ghostty/shaders/cursor-sweep.glsl
custom-shader-animation = true

theme = TokyoNight

window-theme = dark
window-padding-x = 16
window-padding-y = 16

background-blur = true
background-opacity = 0.95

adw-toolbar-style = flat

macos-titlebar-proxy-icon = hidden
macos-titlebar-style = tabs
macos-icon = glass
